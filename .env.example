# Supabase
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
GOOGLE_API_KEY=

# Realtime rooms (Cloudflare PartyServer worker in party/, see party/README.md)
# PARTY_SECRET is server-only - never prefix with VITE_. Same value in party/.dev.vars.
PARTY_SECRET=replace-with-openssl-rand-hex-32
VITE_PARTY_HOST=localhost:1999

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/dashboard
VITE_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe (server-only - never prefix with VITE_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` (dev) or the dashboard endpoint
STRIPE_PRICE_DAY=price_...               # 24h day pass (one-time)
STRIPE_PRICE_MONTH=price_...             # monthly subscription
STRIPE_PRICE_YEAR=price_...              # yearly subscription

# App URL (Stripe redirect base - no trailing slash)
APP_URL=http://localhost:5173


# Misc
VITE_CLAUDE_API_KEY=

# Image pairs (server only)
SUPABASE_SERVICE_ROLE_KEY=
IMAGE_PAIR_N8N_WEBHOOK_URL=
IMAGE_PAIR_N8N_WEBHOOK_SECRET=
UNSPLASH_ACCESS_KEY=
UNSPLASH_PAIR_IMPORT_ENABLED=false
