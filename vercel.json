{
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://eu-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://eu.i.posthog.com/:path*"
    },
    {
      "source": "/daily",
      "destination": "/daily/index.html"
    },
    {
      "source": "/daily/archive",
      "destination": "/daily/archive/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/((?!api/|@|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "realvsai.buzz"
        }
      ],
      "destination": "https://realvsai.playam.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.realvsai.buzz"
        }
      ],
      "destination": "https://realvsai.playam.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "real-vs-ai.buzz"
        }
      ],
      "destination": "https://realvsai.playam.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.real-vs-ai.buzz"
        }
      ],
      "destination": "https://realvsai.playam.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "real-vs-ai.playam.app"
        }
      ],
      "destination": "https://realvsai.playam.app/:path*",
      "permanent": true
    }
  ]
}
