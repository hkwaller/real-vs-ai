            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record generation failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decode JPEG": {
      "main": [
        [
          {
            "node": "Save counterpart",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record generation failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save counterpart": {
      "main": [
        [],
        [
          {
            "node": "Record generation failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 300,
    "saveDataSuccessExecution": "none",
